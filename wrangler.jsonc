{
  // Konfigurasi untuk Cloudflare Workers (alur "Connect GitHub" + npx wrangler deploy).
  // Situs ini murni statis: tidak ada "main", hanya folder hasil build.
  "name": "konsultasifiqih",
  "compatibility_date": "2026-09-11",

  // TIDAK ADA "routes" di sini — disengaja.
  //
  // Custom domain konsultasifiqih.com sudah terpasang lewat deploy pertama.
  // Pada deploy berikutnya wrangler justru menolak dengan
  //   "Can't deploy routes that are assigned to another worker.
  //    'null' is already assigned to routes: konsultasifiqih.com"
  // karena custom domain yang sudah ada terbaca sebagai milik worker lain.
  //
  // Dokumentasi Cloudflare: "To manage routes via the Cloudflare dashboard
  // only, remove any route and routes keys from your Wrangler configuration
  // file." Jadi domain diurus dari dasbor, dan deploy tidak lagi gagal.

  "assets": {
    // hasil "python bangun_situs.py"
    "directory": "./keluaran",

    // /nama-artikel/ dilayani dari /nama-artikel/index.html
    "html_handling": "auto-trailing-slash",

    // alamat yang tidak ada -> halaman 404.html buatan sendiri
    "not_found_handling": "404-page"
  }

  // Catatan: _redirects (212 aturan) dan _headers ikut di dalam ./keluaran
  // dan dibaca otomatis oleh Workers — tidak perlu didaftarkan di sini.
}
